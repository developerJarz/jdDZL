# Server-only MongoDB credentials. Never use NEXT_PUBLIC_ for the URI.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DB=dazzle_store
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
# Copied pages do not contain real inventory. Set quantities in the dashboard after import.
IMPORT_INITIAL_STOCK=0
# Set to your exact public origin when running behind a reverse proxy.
# APP_ORIGIN=https://your-domain.com
# Enable only behind a proxy that overwrites the X-Forwarded-For header.
TRUST_PROXY=false

# Absolute site URL used for canonical links, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable indexing when the store is ready to launch.
NEXT_PUBLIC_ALLOW_INDEXING=false
